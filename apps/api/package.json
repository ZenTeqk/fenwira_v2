{
  "name": "@fenwira/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "default": "./dist/bootstrap.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/index.d.ts",
      "default": "./dist/modules/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.int.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1139.0",
    "@aws-sdk/s3-request-presigner": "3.1139.0",
    "@fenwira/config": "workspace:*",
    "@fenwira/contracts": "workspace:*",
    "@fenwira/database": "workspace:*",
    "@fenwira/queue": "workspace:*",
    "@fenwira/whatsapp": "workspace:*",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/websockets": "11.2.6",
    "@node-rs/argon2": "2.2.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "bullmq": "5.81.5",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "libphonenumber-js": "1.13.14",
    "nestjs-pino": "4.6.1",
    "nodemailer": "10.0.12",
    "papaparse": "5.7.0",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "undici": "8.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@seriousme/openapi-schema-validator": "2.9.1",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/papaparse": "5.5.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "9.2.4",
    "socket.io-client": "4.8.3",
    "supertest": "7.3.1",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.3"
  }
}
