# Fenwira worker (BullMQ processors, outbox relay, schedulers) — production environment.
# Install as /etc/fenwira/worker.env (owner root, mode 0640, group fenwira). Placeholders in
# <angle brackets>. Schema: packages/config/src/env.ts (workerEnvSchema). Validate with
# deploy/scripts/check-env.sh worker <file>.

NODE_ENV=production
APP_VERSION=<git-sha>
LOG_LEVEL=info

# Health endpoint only (no public traffic). Loopback.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=4100

WEB_ORIGIN=https://app.fenwira.zenteqk.com

DATABASE_URL=postgresql://fenwira_app:<password>@<rds-endpoint>:5432/fenwira?sslmode=require&sslaccept=strict&sslcert=/etc/fenwira/rds-ca-ap-south-1-rsa2048-g1.pem&sslrootcert=/etc/fenwira/rds-global-bundle.pem
DB_POOL_SIZE=10
REDIS_URL=redis://127.0.0.1:6379/0
OUTBOX_POLL_INTERVAL_MS=250

ENCRYPTION_KEYS=k1:<base64 32-byte key>
ENCRYPTION_ACTIVE_KEY_ID=k1

# Amazon SES SMTP (infra/terraform/ses.tf); written to SSM by deploy/scripts/ses-smtp-credentials.py. smtps:// = implicit TLS
# (465); smtp:// with STARTTLS (587). URL-encode the password.
SMTP_URL=smtps://<user>:<url-encoded-password>@<smtp-host>:465
MAIL_FROM=Fenwira <no-reply@<verified sending domain>>
OPS_ALERT_EMAIL=<ops mailbox>

# Amazon S3 (instance role when the key pair is unset).
S3_ENDPOINT=https://s3.<region>.amazonaws.com
S3_REGION=<region>
S3_FORCE_PATH_STYLE=false
S3_BUCKET_MEDIA=<bucket>
S3_BUCKET_UPLOADS=<bucket>
S3_BUCKET_IMPORTS=<bucket>
S3_BUCKET_EXPORTS=<bucket>

META_APP_ID=<app id>
META_APP_SECRET=<app secret>
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
WHATSAPP_SYNC_INTERVAL_HOURS=6
WHATSAPP_OUTBOUND_BACKOFF_MS=1000
CAMPAIGN_BATCH_SIZE=50

NATIVE_GOOGLE_CLIENT_ID=
NATIVE_GOOGLE_CLIENT_SECRET=
NATIVE_ZOHO_CLIENT_ID=
NATIVE_ZOHO_CLIENT_SECRET=
NATIVE_SHOPIFY_CLIENT_ID=
NATIVE_SHOPIFY_CLIENT_SECRET=

BILLING_ENFORCED=false
BILLING_SUBSCRIPTIONS_ENFORCED=false
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=GROWTH
TRIAL_CREDIT_MINOR=0
BILLING_LOW_BALANCE_THRESHOLD_MINOR=10000
BILLING_RESERVATION_GRACE_MINUTES=360
ANALYTICS_SETTLE_SECONDS=20

WEBHOOK_BACKOFF_MS=30000
WEBHOOK_MAX_RETRY_HOURS=24
WEBHOOK_DISABLE_AFTER_FAILURES=20

NODE_OPTIONS=--max-old-space-size=768
