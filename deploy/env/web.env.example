# Fenwira web (Next.js standalone server) — production runtime environment.
# Install as /etc/fenwira/web.env. It holds no secrets (apps/web/lib/env.ts).
# NEXT_PUBLIC_API_URL is NOT read here: it is baked in at build time
# (deploy/scripts/build-release.sh requires it).

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
# Next.js standalone reads HOSTNAME/PORT. Loopback: nginx proxies app.fenwira.zenteqk.com here.
HOSTNAME=127.0.0.1
PORT=3000

WEB_ORIGIN=https://app.fenwira.zenteqk.com
# Server-side calls to the API on the same host (the default is the Docker hostname).
API_INTERNAL_URL=http://127.0.0.1:4000
ENABLE_UI_GALLERY=false

NODE_OPTIONS=--max-old-space-size=384
