# Fenwira migrations — used only by deploy/scripts/migrate.sh, never by a long-running service.
# Install as /etc/fenwira/migrate.env (owner root, mode 0600). Role fenwira_owner owns the schema.
NODE_ENV=production
MIGRATION_DATABASE_URL=postgresql://fenwira_owner:<password>@<rds-endpoint>:5432/fenwira?sslmode=require&sslaccept=strict&sslcert=/etc/fenwira/rds-ca-ap-south-1-rsa2048-g1.pem&sslrootcert=/etc/fenwira/rds-global-bundle.pem
