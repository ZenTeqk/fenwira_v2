# Fenwira API — production environment (native, systemd). Install as /etc/fenwira/api.env
# (owner root, mode 0640, group fenwira). Values in <angle brackets> are placeholders; never commit
# real values. Schema and defaults: packages/config/src/env.ts (apiEnvSchema). Reference:
# docs/deployment/ENVIRONMENT_VARIABLES.md. Validate with deploy/scripts/check-env.sh api <file>.

NODE_ENV=production
APP_VERSION=<git-sha>
LOG_LEVEL=info

# Bind to loopback: nginx is the only public entry point.
HOST=127.0.0.1
PORT=4000

WEB_ORIGIN=https://app.fenwira.zenteqk.com
PUBLIC_API_URL=https://api.fenwira.zenteqk.com
COOKIE_SECURE=true
COOKIE_DOMAIN=.fenwira.zenteqk.com
# One proxy hop (nginx on the same host).
TRUST_PROXY=1

# RDS, runtime role fenwira_app (no BYPASSRLS). TLS verified: Prisma reads its CA from sslcert (only
# the FIRST certificate in the file, and only with sslaccept=strict), so sslcert is the single region
# root; node-postgres reads sslrootcert, the full RDS bundle (docs/deployment/PRODUCTION_RUNTIME.md).
DATABASE_URL=postgresql://fenwira_app:<password>@<rds-endpoint>:5432/fenwira?sslmode=require&sslaccept=strict&sslcert=/etc/fenwira/rds-ca-ap-south-1-rsa2048-g1.pem&sslrootcert=/etc/fenwira/rds-global-bundle.pem
DB_POOL_SIZE=10

# Redis on this host (deploy/redis/fenwira-redis.conf). Use redis://:<password>@... if requirepass is set.
REDIS_URL=redis://127.0.0.1:6379/0

# Secrets (generate with `pnpm setup:env`, copy the values; never reuse development ones).
JWT_PRIVATE_KEY=<base64 PEM>
JWT_PUBLIC_KEY=<base64 PEM>
ENCRYPTION_KEYS=k1:<base64 32-byte key>
ENCRYPTION_ACTIVE_KEY_ID=k1
API_KEY_PEPPER=<random, at least 16 characters>
API_KEY_RATE_LIMIT_PER_MINUTE=120

# Amazon S3. Leave S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY unset to use the EC2 instance role.
S3_ENDPOINT=https://s3.<region>.amazonaws.com
S3_REGION=<region>
S3_FORCE_PATH_STYLE=false
S3_BUCKET_MEDIA=<bucket>
S3_BUCKET_UPLOADS=<bucket>
S3_BUCKET_IMPORTS=<bucket>
S3_BUCKET_EXPORTS=<bucket>

# Meta WhatsApp Cloud API (real Graph API; the mock and dev connect are refused in production).
META_APP_ID=<app id>
META_APP_SECRET=<app secret>
META_ES_CONFIG_ID=<embedded signup config id>
META_WEBHOOK_VERIFY_TOKEN=<random>
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
WHATSAPP_DEV_CONNECT=false
SYSTEM_PING_ENABLED=false

# Native connector OAuth apps (optional; callback <WEB_ORIGIN>/integrations/native/callback).
NATIVE_GOOGLE_CLIENT_ID=
NATIVE_GOOGLE_CLIENT_SECRET=
NATIVE_ZOHO_CLIENT_ID=
NATIVE_ZOHO_CLIENT_SECRET=
NATIVE_SHOPIFY_CLIENT_ID=
NATIVE_SHOPIFY_CLIENT_SECRET=

# ADR-0027 Managed Launch Mode: operators connect WhatsApp from /platform; Embedded Signup and
# tenant-side Meta connection changes are hidden (404).
MANAGED_LAUNCH_MODE=false

# ADR-0027 manual UPI billing (docs/BILLING.md → Manual invoices). Payment requests can't be issued
# until both UPI values are set. Grace/lead days are business decisions (ML-D5). GST is added only
# when both GSTIN and rate are set (Q22 open).
UPI_VPA=
UPI_PAYEE_NAME=
BILLING_GRACE_DAYS=7
BILLING_INVOICE_LEAD_DAYS=7
# Upgrade now: "we confirm payments within X hours" on Billing (1-168; unset hides it).
BILLING_PAYMENT_CONFIRM_HOURS=
BILLING_GSTIN=
BILLING_GST_RATE_BPS=

# Billing (business decisions; both default false).
BILLING_ENFORCED=false
BILLING_SUBSCRIPTIONS_ENFORCED=false
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=GROWTH

# AI Assistant (docs/AI_ASSISTANT.md, ADR-0028). Credentials: the instance role (bedrock:InvokeModel).
# Needs `CREATE EXTENSION vector` once (RDS master user) before the first deploy with it.
AI_PROVIDER=bedrock
AI_BEDROCK_REGION=ap-south-1
AI_TEXT_MODEL_ID=apac.amazon.nova-lite-v1:0
AI_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
AI_EMBEDDING_DIMENSION=1024
AI_REPLY_LOG_RETENTION_DAYS=30
TRIAL_CREDIT_MINOR=0
BILLING_LOW_BALANCE_THRESHOLD_MINOR=10000
BILLING_SUPPORT_EMAIL=
BILLING_SUPPORT_URL=

# Internal Prometheus listener: off unless METRICS_PORT is set; always loopback in production.
METRICS_HOST=127.0.0.1
# METRICS_PORT=9464

# Node.js heap ceiling (docs/deployment/RESOURCE_BUDGET.md).
NODE_OPTIONS=--max-old-space-size=512
