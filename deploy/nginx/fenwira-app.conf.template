# app.fenwira.zenteqk.com → Next.js standalone server on 127.0.0.1:3000.
# Rendered by deploy/scripts/render-nginx.sh: @@APP_DOMAIN@@, @@TLS_CERT@@, @@TLS_KEY@@,
# @@WEB_STATIC_DIR@@ (the release's .next/static, served directly).

upstream fenwira_web {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@APP_DOMAIN@@;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    # `listen … http2` (not `http2 on;`): Ubuntu 24.04 ships nginx 1.24; `http2 on` needs ≥ 1.25.1.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@APP_DOMAIN@@;

    ssl_certificate     @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;
    include /etc/nginx/snippets/fenwira-tls.conf;
    include /etc/nginx/snippets/fenwira-security-headers.conf;

    client_max_body_size 1m;

    # Content-hashed build assets: served from disk, cached for a year.
    location /_next/static/ {
        alias @@WEB_STATIC_DIR@@/;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/fenwira-security-headers.conf;
    }

    location / {
        proxy_pass http://fenwira_web;
        include /etc/nginx/snippets/fenwira-proxy.conf;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
