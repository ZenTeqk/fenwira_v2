# ADR-0027 item B: the company site at the apex (company details, privacy policy, terms; Meta
# business verification links to it). Static files only. @@SITE_DOMAIN@@, @@SITE_ROOT@@,
# @@TLS_CERT@@, @@TLS_KEY@@ (the fenwira.com certificate also covers app/api).

server {
    listen 80;
    listen [::]:80;
    server_name @@SITE_DOMAIN@@;
    location /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@SITE_DOMAIN@@;

    ssl_certificate     @@TLS_CERT@@;
    ssl_certificate_key @@TLS_KEY@@;
    include /etc/nginx/snippets/fenwira-tls.conf;
    include /etc/nginx/snippets/fenwira-security-headers.conf;

    root @@SITE_ROOT@@;
    index index.html;
    location / { try_files $uri $uri.html $uri/ =404; }
}
