# Groups the Fenwira services: `systemctl start|stop|restart fenwira.target`.
# Membership comes only from enabled units (`systemctl enable fenwira-<svc>` links them into
# fenwira.target.wants via their WantedBy=). There is deliberately no Wants= list here: a disabled
# unit (today the worker, until SMTP is configured) must stay off at boot and on target start.
# Each service has PartOf=fenwira.target, so stop/restart of the target reaches every running one.
[Unit]
Description=Fenwira application (enabled units among api, worker, web)
After=network-online.target redis-server.service

[Install]
WantedBy=multi-user.target
