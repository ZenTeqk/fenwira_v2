# Fenwira v2 — environment for `docker compose up -d` (docs/DEPLOYMENT.md → Environment variables).
# Copy to .env. These defaults are safe for LOCAL development only; `pnpm setup:env` writes a .env
# with freshly generated random secrets instead. Never commit .env.

# ---- Runtime --------------------------------------------------------------------------------
NODE_ENV=development           # 'production' enforces real deployment guardrails (secure cookies, JWT keys, no ping)
APP_VERSION=dev                # CI sets the git SHA
LOG_LEVEL=info                 # fatal | error | warn | info | debug | trace | silent

# ---- Published host ports ------------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
MINIO_API_PORT=9000            # S3 API: browsers use it for presigned uploads/downloads (Phase 5+)
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025

# ---- URLs ------------------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000                       # CORS / CSRF origin for the API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1       # baked into the web build

# ---- Postgres (roles created on first start by infrastructure/docker/postgres/init) ----------
POSTGRES_PASSWORD=postgres-local-only                  # superuser, container init only
FENWIRA_OWNER_PASSWORD=owner-local-only                # fenwira_owner: migrations/DDL
FENWIRA_APP_PASSWORD=app-local-only                    # fenwira_app: runtime DML, NOBYPASSRLS
DB_POOL_SIZE=10

# ---- MinIO (S3-compatible storage) -------------------------------------------------------------
S3_ACCESS_KEY_ID=fenwira-local
S3_SECRET_ACCESS_KEY=fenwira-local-secret
S3_PUBLIC_ENDPOINT=http://localhost:9000   # browsers upload/download media with presigned URLs here

# ---- Auth & secrets (Phase 3) ------------------------------------------------------------------
# AES-256-GCM key ring for secrets at rest (TOTP secrets, Meta tokens). LOCAL ONLY value.
ENCRYPTION_KEYS=k1:ZmVud2lyYS1sb2NhbC1kZXYtZW5jcnlwdGlvbi1rZXk=
ENCRYPTION_ACTIVE_KEY_ID=k1
# Ed25519 keys (base64 PEM) for access tokens. Empty = generated per boot (development only);
# `pnpm setup:env` writes real ones. Required when NODE_ENV=production.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
COOKIE_SECURE=false            # true behind HTTPS (required in production)
MAIL_FROM=Fenwira <no-reply@fenwira.local>

# ---- Worker ----------------------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=250

# ---- WhatsApp / Meta (Phase 4, docs/META_INTEGRATION.md) ---------------------------------------
# Real Embedded Signup needs a Meta app with Tech Provider access. Leave empty to turn it off.
META_APP_ID=
# Also signs/verifies webhooks. Locally it is shared with fenwira-meta-mock (LOCAL ONLY value).
META_APP_SECRET=local-mock-app-secret
META_ES_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=local-verify-token   # GET /webhooks/whatsapp handshake
META_GRAPH_API_VERSION=v23.0
# Local development uses the simulated Graph API (fenwira-meta-mock, enabled by COMPOSE_PROFILES).
# For real Meta set META_GRAPH_BASE_URL=https://graph.facebook.com and remove the profile.
COMPOSE_PROFILES=meta-mock
META_GRAPH_BASE_URL=http://fenwira-meta-mock:4200
META_MOCK_PORT=4200
# Manual connect with a pasted token (Meta test number). NEVER true in production.
WHATSAPP_DEV_CONNECT=true
WHATSAPP_SYNC_INTERVAL_HOURS=6

# Billing (Phase 9 slice of Phase 11). When true, billable (template) sends reserve wallet funds
# (docs/BILLING.md → Reservations). Top up with: pnpm --filter @fenwira/worker wallet:credit -- --tenant <id> --amount 500
BILLING_ENFORCED=false
# ADR-0027 Managed Launch Mode: operators connect WhatsApp from /platform; Embedded Signup and
# tenant-side Meta connection changes are hidden (404).
MANAGED_LAUNCH_MODE=false

# ADR-0027 manual UPI billing (docs/BILLING.md → Manual invoices). Payment requests can't be issued
# until both UPI values are set. Grace/lead days are business decisions (ML-D5). GST is added only
# when both GSTIN and rate are set (Q22 open).
UPI_VPA=
UPI_PAYEE_NAME=
BILLING_GRACE_DAYS=7
BILLING_INVOICE_LEAD_DAYS=7
BILLING_GSTIN=
BILLING_GST_RATE_BPS=
# Phase 11 Step 4 (docs/BILLING.md → Plans): plans/subscriptions drive limits and capabilities.
# false = every workspace allow-all (local development); production sets true.
BILLING_SUBSCRIPTIONS_ENFORCED=false
BILLING_TRIAL_DAYS=14              # P11-D5 billing.trial_days
BILLING_TRIAL_PLAN=GROWTH          # P11-D5: the plan whose entitlements a trial resolves to (data)
# Credit (paise) granted once to a new TRIAL tenant's wallet (P9-D1). Production sets this; 0 = none.
TRIAL_CREDIT_MINOR=0
# P11-D12: available funds (paise) at or below which the wallet is LOW_BALANCE. ₹100 default.
BILLING_LOW_BALANCE_THRESHOLD_MINOR=10000
# P11-D20: where members arrange top-ups. Unset = the "Contact Fenwira" fallback, no action.
BILLING_SUPPORT_EMAIL=
BILLING_SUPPORT_URL=
# Worker: recover reservations whose message ended this many minutes ago without settling.
BILLING_RESERVATION_GRACE_MINUTES=360
# Worker: operational alerts (decision O1). Unset = alerts are only logged.
OPS_ALERT_EMAIL=ops@fenwira.local
# Campaign recipients handed to MessagingService per dispatch job.
CAMPAIGN_BATCH_SIZE=50
WHATSAPP_OUTBOUND_BACKOFF_MS=1000   # outbound retries wait 2^n × this (±20 %)
PUBLIC_API_URL=http://localhost:4000

# ---- Diagnostics -----------------------------------------------------------------------------
# Enables the unauthenticated POST /api/v1/system/ping end-to-end probe. NEVER true in production.
SYSTEM_PING_ENABLED=true
# Serves the /dev/ui component gallery (used by the accessibility e2e suite). Off in production.
ENABLE_UI_GALLERY=true
# Build-time: show navigation for modules from future phases (placeholder pages). Development only.
NEXT_PUBLIC_NAV_PREVIEW=false

# Phase 11 Step 3: API keys (docs/API_KEYS.md). A fixed value keeps local keys working across
# restarts; production must set a real secret (refused otherwise).
API_KEY_PEPPER=development-only-api-key-pepper
API_KEY_RATE_LIMIT_PER_MINUTE=120

# Phase 11 Step 3: outbound webhook delivery (docs/WEBHOOKS.md). Worker only.
WEBHOOK_BACKOFF_MS=30000
WEBHOOK_MAX_RETRY_HOURS=24
WEBHOOK_DISABLE_AFTER_FAILURES=20

# Native connector OAuth applications (server only; register callback in provider console).
# Callback: <WEB_ORIGIN>/integrations/native/callback
NATIVE_GOOGLE_CLIENT_ID=
NATIVE_GOOGLE_CLIENT_SECRET=
NATIVE_ZOHO_CLIENT_ID=
NATIVE_ZOHO_CLIENT_SECRET=
NATIVE_SHOPIFY_CLIENT_ID=
NATIVE_SHOPIFY_CLIENT_SECRET=
