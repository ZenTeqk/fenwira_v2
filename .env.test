# Integration test runner (fenwira-test compose service and CI). Connection URLs are set by
# docker-compose.yml / the CI workflow, pointing at the fenwira_test database and Redis db 1.
NODE_ENV=test
APP_VERSION=test
LOG_LEVEL=silent
WEB_ORIGIN=http://localhost:3000
SYSTEM_PING_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=100
DB_POOL_SIZE=5
ENCRYPTION_KEYS=k1:dGVzdC1vbmx5LWVuY3J5cHRpb24ta2V5LTMyYnl0ZXM=
ENCRYPTION_ACTIVE_KEY_ID=k1
COOKIE_SECURE=false
MAIL_FROM=Fenwira Test <no-reply@fenwira.test>
