{
  "name": "@fenwira/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "sql"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.int.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "db:deploy": "node dist/cli/migrate.js",
    "db:check-rls": "node dist/cli/check-rls.js",
    "db:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --script",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "dependencies": {
    "@fenwira/config": "workspace:*",
    "@fenwira/contracts": "workspace:*",
    "@prisma/client": "6.19.3",
    "pg": "8.23.0",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "vitest": "3.2.7"
  }
}
