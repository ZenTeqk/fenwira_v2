enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED

  @@map("subscription_status")
}

/// One per tenant. Independent of tenants.billing_mode and of the wallet (P11-D9).
model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  /// Kept after expiry/cancel: the expired profile reuses its limits (nothing turns over-limit by expiring).
  planId             String?            @map("plan_id") @db.Uuid
  /// P11-D24: the OWNER requests a plan; an operator activates it.
  requestedPlanId    String?            @map("requested_plan_id") @db.Uuid
  requestedAt        DateTime?          @map("requested_at") @db.Timestamptz(3)
  status             SubscriptionStatus @default(TRIALING)
  interval           BillingInterval    @default(MONTH)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  expiredAt          DateTime?          @map("expired_at") @db.Timestamptz(3)
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  /// Trial-ending notices already sent: e.g. ["T-3","T-1"].
  noticesSent        String[]           @default([]) @map("notices_sent")
  /// key → ISO time it first went over limit (daily snapshot; never changes data).
  overLimitSince     Json               @default("{}") @map("over_limit_since")
  provider           String?
  providerRef        String?            @map("provider_ref")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan?  @relation("SubscriptionPlan", fields: [planId], references: [id])
  requestedPlan Plan?  @relation("SubscriptionRequestedPlan", fields: [requestedPlanId], references: [id])

  @@index([status, trialEndsAt])
  @@map("subscriptions")
}

/// Per-tenant entitlement override; wins over the plan/trial profile until expires_at.
