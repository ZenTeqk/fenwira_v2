  body      String
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation("CannedReplyAuthor", fields: [createdBy], references: [id])

  @@unique([tenantId, shortcut])
  @@map("canned_replies")
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION

  @@map("template_category")
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  ARCHIVED

  @@map("template_status")
}

enum TemplateOrigin {
  FENWIRA
  META

  @@map("template_origin")
}

/// A WhatsApp message template, identified like Meta: (WABA, name, language) (docs/TEMPLATE_ENGINE.md).
model Template {
  id                String           @id @default(uuid(7)) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  wabaId            String           @map("waba_id") @db.Uuid
  name              String
  language          String
  category          TemplateCategory
  /// Mirrors the current version's status.
  status            TemplateStatus   @default(DRAFT)
  currentVersionId  String?          @map("current_version_id") @db.Uuid
  approvedVersionId String?          @map("approved_version_id") @db.Uuid
  qualityScore      String?          @map("quality_score")
  createdBy         String?          @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waba     WhatsAppBusinessAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  versions TemplateVersion[]       @relation("TemplateVersions")

  @@index([tenantId, status])
  @@map("templates")
}

/// Immutable once submitted; editing an approved/rejected template creates version N+1.
model TemplateVersion {
  id              String         @id @default(uuid(7)) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  templateId      String         @map("template_id") @db.Uuid
  version         Int
  components      Json
  variableSamples Json           @map("variable_samples")
  sampleFileId    String?        @map("sample_file_id") @db.Uuid
  metaTemplateId  String?        @map("meta_template_id")
  status          TemplateStatus @default(DRAFT)
  origin          TemplateOrigin @default(FENWIRA)
  qualityScore    String?        @map("quality_score")
  rejectionReason String?        @map("rejection_reason")
  lastError       String?        @map("last_error")
  submittedAt     DateTime?      @map("submitted_at") @db.Timestamptz(3)
  decidedAt       DateTime?      @map("decided_at") @db.Timestamptz(3)
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   Template  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  sampleFile File?     @relation("TemplateSampleFile", fields: [sampleFileId], references: [id], onDelete: SetNull)
  author     User?     @relation("TemplateVersionAuthor", fields: [createdBy], references: [id], onDelete: SetNull)
  messages   Message[]

  @@unique([templateId, version])
  @@index([tenantId, metaTemplateId])
  @@map("template_versions")
}
