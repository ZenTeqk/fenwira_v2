// Source of truth for tables is docs/DATABASE.md. Things Prisma cannot express (RLS policies,
// partial indexes, grants, SECURITY DEFINER functions, triggers) live in ../sql/post-migrate.sql,
// which runs after every `prisma migrate deploy` (ADR-0016).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED

  @@map("outbox_status")
}

/// Transactional outbox (ADR-0013). tenant_id NULL = platform event, writable only through
/// system.emit_platform_event(); tenant events are inserted inside withTenant() and RLS-checked.
model OutboxEvent {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String?      @map("tenant_id") @db.Uuid
  eventType     String       @map("event_type")
  aggregateType String?      @map("aggregate_type")
  aggregateId   String?      @map("aggregate_id") @db.Uuid
  payload       Json
  correlationId String?      @map("correlation_id")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  lastError     String?      @map("last_error")
  dispatchedAt  DateTime?    @map("dispatched_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------------------------
// Identity (Phase 3) — global tables, no tenant_id, reached only through the identity module.
// ---------------------------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  name            String
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  locale          String    @default("en")
  timezone        String    @default("Asia/Kolkata")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  twoFactor               TwoFactorCredential?
  securityEvents          SecurityEvent[]
  memberships             Membership[]
  ownedTenants            Tenant[]                 @relation("TenantOwner")
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  ownedContacts           Contact[]                @relation("ContactOwner")
  contactNotes            ContactNote[]            @relation("ContactNoteAuthor")
  assignedConversations   Conversation[]           @relation("ConversationAssignee")
  readStates              ConversationReadState[]  @relation("ConversationReader")
  conversationNotes       ConversationNote[]       @relation("ConversationNoteAuthor")
  notifications           Notification[]           @relation("NotificationRecipient")
  cannedReplies           CannedReply[]            @relation("CannedReplyAuthor")
  templateVersions        TemplateVersion[]        @relation("TemplateVersionAuthor")

  @@map("users")
}

/// One row per refresh token. Rotation creates a child row in the same family and revokes the
/// parent (reason ROTATED); presenting a ROTATED token revokes the whole family (reuse detection).
model Session {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  parentId         String?   @map("parent_id") @db.Uuid
  refreshTokenHash Bytes     @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?   @db.Inet
  lastUsedAt       DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model TwoFactorCredential {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext Bytes     @map("secret_ciphertext")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz(3)
  backupCodeHashes String[]  @map("backup_code_hashes")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_credentials")
}

enum SecurityEventType {
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  TWO_FACTOR_ENABLED
  TWO_FACTOR_DISABLED
  BACKUP_CODE_USED
  SESSION_REVOKED
  ALL_SESSIONS_REVOKED
  REFRESH_TOKEN_REUSE

  @@map("security_event_type")
}

/// User-level security trail (not tenant-scoped); tenant actions go to audit_logs. Append-only.
model SecurityEvent {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  type      SecurityEventType
  ip        String?           @db.Inet
  userAgent String?           @map("user_agent")
  metadata  Json?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("security_events")
}

// ---------------------------------------------------------------------------------------------
// Tenancy (Phase 3)
// ---------------------------------------------------------------------------------------------

/// Tenant root ("Workspace" in the UI). Custom RLS: visible when bound or when the current user is
/// an ACTIVE member (post-migrate.sql → tenant_root).
model Tenant {
  id                       String          @id @default(uuid(7)) @db.Uuid
  name                     String
  slug                     String          @unique @db.Citext
  defaultCountry           String          @default("IN") @map("default_country") @db.Char(2)
  timezone                 String          @default("Asia/Kolkata")
  currency                 String          @default("INR") @db.Char(3)
  require2fa               Boolean         @default(false) @map("require_2fa")
  /// Whole-message keywords that revoke / grant MARKETING consent (case-insensitive).
  optOutKeywords           String[]        @default(["STOP", "UNSUBSCRIBE", "CANCEL", "STOP ALL", "OPT OUT"]) @map("opt_out_keywords")
  optInKeywords            String[]        @default(["START", "SUBSCRIBE", "OPT IN"]) @map("opt_in_keywords")
  /// Reply after an opt-out (a SERVICE message). Empty = no reply.
  optOutReply              String?         @default("You're unsubscribed from marketing messages. Reply START to subscribe again.") @map("opt_out_reply")
  autoAssign               AutoAssignMode  @default(OFF) @map("auto_assign")
  inboxVisibility          InboxVisibility @default(ALL) @map("inbox_visibility")
  /// Return AGENT_TAKEOVER to automation after N idle hours on a resolved conversation (null = never).
  takeoverAutoReleaseHours Int?            @map("takeover_auto_release_hours")
  ownerUserId              String          @map("owner_user_id") @db.Uuid
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?       @map("deleted_at") @db.Timestamptz(3)

  owner                    User                        @relation("TenantOwner", fields: [ownerUserId], references: [id])
  memberships              Membership[]
  invitations              Invitation[]
  auditLogs                AuditLog[]
  outboxEvents             OutboxEvent[]
  metaBusinessAccounts     MetaBusinessAccount[]
  whatsappBusinessAccounts WhatsAppBusinessAccount[]
  whatsappPhoneNumbers     WhatsAppPhoneNumber[]
  metaCredentials          MetaCredential[]
  webhookSubscriptions     WebhookSubscription[]
  contacts                 Contact[]
  conversations            Conversation[]
  messages                 Message[]
  webhookEvents            WebhookEvent[]
  files                    File[]
  idempotencyKeys          IdempotencyKey[]
  contactPropertyDefs      ContactPropertyDefinition[]
  contactPropertyValues    ContactPropertyValue[]
  tags                     Tag[]
  contactTags              ContactTag[]
  contactNotes             ContactNote[]
  consents                 Consent[]
  contactActivities        ContactActivity[]
  segments                 Segment[]
  importJobs               ImportJob[]
  importJobErrors          ImportJobError[]
  exportJobs               ExportJob[]
  readStates               ConversationReadState[]
  conversationNotes        ConversationNote[]
  conversationTags         ConversationTag[]
  notifications            Notification[]
  cannedReplies            CannedReply[]
  templates                Template[]
  templateVersions         TemplateVersion[]

  @@map("tenants")
}

enum RoleKey {
  OWNER
  ADMIN
  MANAGER
  AGENT
  VIEWER

  @@map("role_key")
}

/// Seeded from @fenwira/contracts (rbac.ts) by the migrate step; read-only for fenwira_app.
model Role {
  key         RoleKey          @id
  name        String
  rank        Int
  permissions RolePermission[]
  memberships Membership[]
  invitations Invitation[]

  @@map("roles")
}

model Permission {
  key         String           @id
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleKey       RoleKey @map("role_key")
  permissionKey String  @map("permission_key")

  role       Role       @relation(fields: [roleKey], references: [key], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleKey, permissionKey])
  @@map("role_permissions")
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED

  @@map("membership_status")
}

/// Exactly one ACTIVE OWNER per tenant (partial unique index in post-migrate.sql).
model Membership {
  id            String           @id @default(uuid(7)) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  userId        String           @map("user_id") @db.Uuid
  role          RoleKey
  status        MembershipStatus @default(ACTIVE)
  joinedAt      DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef Role   @relation(fields: [role], references: [key])

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@map("memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

/// token_hash is set by the worker when it (re)sends the email; the raw token exists only in the
/// email. One PENDING invitation per (tenant, email) — partial unique index in post-migrate.sql.
model Invitation {
  id          String           @id @default(uuid(7)) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  email       String           @db.Citext
  role        RoleKey
  tokenHash   Bytes?           @unique @map("token_hash")
  invitedById String           @map("invited_by") @db.Uuid
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(3)
  sentAt      DateTime?        @map("sent_at") @db.Timestamptz(3)
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitationInviter", fields: [invitedById], references: [id])
  roleRef   Role   @relation(fields: [role], references: [key])

  @@index([tenantId, status])
  @@map("invitations")
}

enum ActorType {
  USER
  API_KEY
  SYSTEM

  @@map("actor_type")
}

/// Tenant audit trail. Append-only: UPDATE/DELETE/TRUNCATE revoked from fenwira_app.
model AuditLog {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  actorType     ActorType @map("actor_type")
  actorId       String?   @map("actor_id") @db.Uuid
  action        String
  targetType    String    @map("target_type")
  targetId      String?   @map("target_id")
  changes       Json?
  ip            String?   @db.Inet
  userAgent     String?   @map("user_agent")
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// WhatsApp accounts (Phase 4, docs/META_INTEGRATION.md). Tokens and PINs are AES-256-GCM
// ciphertext (@fenwira/config encryptSecret) and are decrypted only right before a Graph call.
// ---------------------------------------------------------------------------------------------

model MetaBusinessAccount {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  metaBusinessId String   @map("meta_business_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wabas  WhatsAppBusinessAccount[]

  @@unique([tenantId, metaBusinessId])
  @@map("meta_business_accounts")
}

enum WabaStatus {
  ACTIVE
  RESTRICTED
  DISABLED
  DISCONNECTED

  @@map("waba_status")
}

/// One row per (tenant, WABA). A WABA in several tenants is prevented through its phone numbers
/// (whatsapp_phone_numbers_active_number_unique), which is what actually carries traffic.
model WhatsAppBusinessAccount {
  id                       String     @id @default(uuid(7)) @db.Uuid
  tenantId                 String     @map("tenant_id") @db.Uuid
  metaBusinessAccountId    String?    @map("meta_business_account_id") @db.Uuid
  wabaId                   String     @map("waba_id")
  name                     String
  currency                 String?    @db.Char(3)
  timezoneId               String?    @map("timezone_id")
  messageTemplateNamespace String?    @map("message_template_namespace")
  status                   WabaStatus @default(ACTIVE)
  /// Last successful template sync from Meta (docs/TEMPLATE_ENGINE.md → Sync from Meta).
  templatesSyncedAt        DateTime?  @map("templates_synced_at") @db.Timestamptz(3)
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metaBusinessAccount  MetaBusinessAccount?  @relation(fields: [metaBusinessAccountId], references: [id], onDelete: SetNull)
  phoneNumbers         WhatsAppPhoneNumber[]
  credentials          MetaCredential[]
  webhookSubscriptions WebhookSubscription[]
  templates            Template[]

  @@unique([tenantId, wabaId])
  @@map("whatsapp_business_accounts")
}

enum QualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN

  @@map("quality_rating")
}

enum PhoneStatus {
  PENDING
  CONNECTED
  FLAGGED
  RESTRICTED
  DISCONNECTED
  ERROR

  @@map("phone_status")
}

/// status_detail holds the connection steps [{key, status, error?}] (resumable connect flow).
/// One non-DISCONNECTED row per phone_number_id across all tenants and one default per tenant
/// (partial unique indexes in post-migrate.sql).
model WhatsAppPhoneNumber {
  id                        String        @id @default(uuid(7)) @db.Uuid
  tenantId                  String        @map("tenant_id") @db.Uuid
  wabaId                    String        @map("waba_id") @db.Uuid
  phoneNumberId             String        @map("phone_number_id")
  displayPhoneNumber        String        @map("display_phone_number")
  verifiedName              String        @map("verified_name")
  label                     String?
  qualityRating             QualityRating @default(UNKNOWN) @map("quality_rating")
  messagingLimitTier        String?       @map("messaging_limit_tier")
  throughputMps             Int           @default(80) @map("throughput_mps")
  status                    PhoneStatus   @default(PENDING)
  statusDetail              Json?         @map("status_detail")
  registrationPinCiphertext Bytes?        @map("registration_pin_ciphertext")
  isDefault                 Boolean       @default(false) @map("is_default")
  lastSyncedAt              DateTime?     @map("last_synced_at") @db.Timestamptz(3)
  connectedAt               DateTime?     @map("connected_at") @db.Timestamptz(3)
  disconnectedAt            DateTime?     @map("disconnected_at") @db.Timestamptz(3)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waba          WhatsAppBusinessAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, phoneNumberId])
  @@index([tenantId, status])
  @@map("whatsapp_phone_numbers")
}

enum MetaTokenType {
  BUSINESS_INTEGRATION
  SYSTEM_USER
  DEV

  @@map("meta_token_type")
}

enum CredentialStatus {
  VALID
  EXPIRING
  INVALID
  REVOKED

  @@map("credential_status")
}

/// One live (VALID|EXPIRING) credential per WABA (partial unique in post-migrate.sql). Disconnect
/// and rotation set the old row REVOKED and wipe token_ciphertext.
model MetaCredential {
  id              String           @id @default(uuid(7)) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  wabaId          String           @map("waba_id") @db.Uuid
  tokenCiphertext Bytes?           @map("token_ciphertext")
  tokenLast4      String           @map("token_last4")
  tokenPrefix     String           @map("token_prefix")
  tokenType       MetaTokenType    @map("token_type")
  scopes          String[]
  expiresAt       DateTime?        @map("expires_at") @db.Timestamptz(3)
  status          CredentialStatus @default(VALID)
  lastCheckedAt   DateTime?        @map("last_checked_at") @db.Timestamptz(3)
  rotatedAt       DateTime?        @map("rotated_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waba   WhatsAppBusinessAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)

  @@index([tenantId, wabaId])
  @@map("meta_credentials")
}

enum WebhookSubscriptionStatus {
  ACTIVE
  FAILED
  REMOVED

  @@map("webhook_subscription_status")
}

model WebhookSubscription {
  id               String                    @id @default(uuid(7)) @db.Uuid
  tenantId         String                    @map("tenant_id") @db.Uuid
  wabaId           String                    @map("waba_id") @db.Uuid
  subscribedFields String[]                  @map("subscribed_fields")
  status           WebhookSubscriptionStatus @default(ACTIVE)
  lastEventAt      DateTime?                 @map("last_event_at") @db.Timestamptz(3)
  lastCheckedAt    DateTime?                 @map("last_checked_at") @db.Timestamptz(3)
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  waba   WhatsAppBusinessAccount @relation(fields: [wabaId], references: [id], onDelete: Cascade)

  @@unique([tenantId, wabaId])
  @@map("webhook_subscriptions")
}

// ---------------------------------------------------------------------------------------------
// Messaging (Phase 5, docs/MESSAGING_ENGINE.md). Contacts get their core columns now; consent,
// tags and properties arrive in Phase 6, inbox columns in Phase 7.
// ---------------------------------------------------------------------------------------------

enum ContactSource {
  INBOUND
  MANUAL
  IMPORT
  API
  CAMPAIGN
  AUTOMATION

  @@map("contact_source")
}

enum ContactStatus {
  ACTIVE
  BLOCKED

  @@map("contact_status")
}

/// One live contact per (tenant, phone_e164) — partial unique index in post-migrate.sql.
model Contact {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  phoneE164        String        @map("phone_e164")
  name             String?
  email            String?       @db.Citext
  language         String?
  country          String?       @db.Char(2)
  source           ContactSource
  status           ContactStatus @default(ACTIVE)
  waProfileName    String?       @map("wa_profile_name")
  ownerId          String?       @map("owner_id") @db.Uuid
  /// Current consent per purpose, kept in step with the latest `consents` row (same transaction).
  marketingConsent ConsentState  @default(NONE) @map("marketing_consent")
  utilityConsent   ConsentState  @default(NONE) @map("utility_consent")
  lastInboundAt    DateTime?     @map("last_inbound_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(3)

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner          User?                  @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversations  Conversation[]
  messages       Message[]
  tags           ContactTag[]
  notes          ContactNote[]
  consents       Consent[]
  activities     ContactActivity[]
  propertyValues ContactPropertyValue[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, marketingConsent])
  @@map("contacts")
}

enum ConversationStatus {
  OPEN
  PENDING
  SNOOZED
  RESOLVED

  @@map("conversation_status")
}

enum AutomationState {
  AUTOMATION_ACTIVE
  AGENT_TAKEOVER
  AUTOMATION_PAUSED

  @@map("automation_state")
}

/// One thread per contact per number. service_window_expires_at = last inbound + 24 h.
model Conversation {
  id                       String             @id @default(uuid(7)) @db.Uuid
  tenantId                 String             @map("tenant_id") @db.Uuid
  contactId                String             @map("contact_id") @db.Uuid
  phoneNumberId            String             @map("phone_number_id") @db.Uuid
  status                   ConversationStatus @default(OPEN)
  assigneeId               String?            @map("assignee_id") @db.Uuid
  assignedAt               DateTime?          @map("assigned_at") @db.Timestamptz(3)
  /// Inbound messages ever received; unread for a user with no read-state row.
  inboundCount             Int                @default(0) @map("inbound_count")
  automationState          AutomationState    @default(AUTOMATION_ACTIVE) @map("automation_state")
  automationStateChangedAt DateTime?          @map("automation_state_changed_at") @db.Timestamptz(3)
  automationStateChangedBy String?            @map("automation_state_changed_by") @db.Uuid
  lastMessageId            String?            @map("last_message_id") @db.Uuid
  lastMessageAt            DateTime?          @map("last_message_at") @db.Timestamptz(3)
  lastMessagePreview       String?            @map("last_message_preview")
  lastCustomerMessageAt    DateTime?          @map("last_customer_message_at") @db.Timestamptz(3)
  serviceWindowExpiresAt   DateTime?          @map("service_window_expires_at") @db.Timestamptz(3)
  firstResponseAt          DateTime?          @map("first_response_at") @db.Timestamptz(3)
  resolvedAt               DateTime?          @map("resolved_at") @db.Timestamptz(3)
  snoozedUntil             DateTime?          @map("snoozed_until") @db.Timestamptz(3)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber WhatsAppPhoneNumber     @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  assignee    User?                   @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages    Message[]
  readStates  ConversationReadState[]
  notes       ConversationNote[]
  tags        ConversationTag[]

  @@unique([tenantId, contactId, phoneNumberId])
  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([tenantId, assigneeId, status])
  @@map("conversations")
}

