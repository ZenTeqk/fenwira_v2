/// Prepaid credits (docs/BILLING.md → Wallet). balance_minor is maintained by the ledger trigger.
model Wallet {
  id                       String            @id @default(uuid(7)) @db.Uuid
  tenantId                 String            @unique @map("tenant_id") @db.Uuid
  currency                 String            @default("INR") @db.Char(3)
  balanceMinor             BigInt            @default(0) @map("balance_minor")
  creditLimitMinor         BigInt            @default(0) @map("credit_limit_minor")
  reservedMinor            BigInt            @default(0) @map("reserved_minor")
  lowBalanceThresholdMinor BigInt?           @map("low_balance_threshold_minor")
  /// Funds state last recorded by a wallet change (P11-D12). Only detects crossings; reads
  /// compute the live state. NULL until the first change after creation.
  fundsState               WalletFundsState? @map("funds_state")
  /// P11-D21: when the wallet first had available funds. Null = never funded, so the first
  /// credit is initial funding (`wallet.funded`), not a recovery.
  fundedAt                 DateTime?         @map("funded_at") @db.Timestamptz(3)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  reservations WalletReservation[]

  @@map("wallets")
}

/// Append-only ledger: UPDATE and DELETE are revoked from fenwira_app.
model WalletTransaction {
  id                String                @id @default(uuid(7)) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  walletId          String                @map("wallet_id") @db.Uuid
  type              WalletTransactionType
  amountMinor       BigInt                @map("amount_minor")
  balanceAfterMinor BigInt                @map("balance_after_minor")
  reason            String
  referenceType     String?               @map("reference_type")
  referenceId       String?               @map("reference_id")
  idempotencyKey    String                @map("idempotency_key")
  /// P11-D7: paid funds vs promotional/trial credits.
  fundType          FundType              @default(PAID) @map("fund_type")
  /// P11-D7: expiry metadata for promotional credits. No expiry policy is applied (P11-Q23).
  expiresAt         DateTime?             @map("expires_at") @db.Timestamptz(3)
  createdBy         String?               @map("created_by") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet       Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reservations WalletReservation[]

  @@unique([tenantId, idempotencyKey])
  @@index([walletId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

/// B4: funds held for an accepted billable message until Meta prices it.
model WalletReservation {
  id                   String            @id @default(uuid(7)) @db.Uuid
  tenantId             String            @map("tenant_id") @db.Uuid
  walletId             String            @map("wallet_id") @db.Uuid
  messageId            String            @unique @map("message_id") @db.Uuid
  amountMinor          BigInt            @map("amount_minor")
