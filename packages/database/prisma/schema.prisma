/// An automation (docs/AUTOMATION_ENGINE.md). Executions pin the version they started with.
model Flow {
  id                      String        @id @default(uuid(7)) @db.Uuid
  tenantId                String        @map("tenant_id") @db.Uuid
  name                    String
  description             String?
  status                  FlowStatus    @default(DRAFT)
  activeVersionId         String?       @map("active_version_id") @db.Uuid
  draftVersionId          String?       @map("draft_version_id") @db.Uuid
  reentryPolicy           ReentryPolicy @default(AFTER_COMPLETION) @map("reentry_policy")
  /// AE2: lower runs first; ties by created_at, then id.
  priority                Int           @default(100)
  webhookTokenHash        Bytes?        @unique @map("webhook_token_hash")
  webhookSecretCiphertext Bytes?        @map("webhook_secret_ciphertext")
  createdBy               String?       @map("created_by") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?     @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions   FlowVersion[]
  executions AutomationExecution[]

  @@index([tenantId, status])
  @@map("flows")
}

/// Immutable once PUBLISHED. `graph` is the executable definition; its `layout` is editor-only.
model FlowVersion {
  id               String           @id @default(uuid(7)) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  flowId           String           @map("flow_id") @db.Uuid
  version          Int
  graph            Json
  triggerType      String?          @map("trigger_type")
  triggerConfig    Json?            @map("trigger_config")
  state            FlowVersionState @default(DRAFT)
  validationErrors Json?            @map("validation_errors")
  publishedBy      String?          @map("published_by") @db.Uuid
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow       Flow                  @relation(fields: [flowId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@unique([flowId, version])
  @@index([tenantId, triggerType, state])
  @@map("flow_versions")
}

/// One triggering event: the ordered plan of matched flows and each one's outcome (AE3).
model AutomationTriggerRun {
  id             String           @id @default(uuid(7)) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  eventId        String           @map("event_id") @db.Uuid
  triggerType    String           @map("trigger_type")
  contactId      String           @map("contact_id") @db.Uuid
  conversationId String?          @map("conversation_id") @db.Uuid
  /// What executions of this run see as `trigger.*` (message, webhook body, contact source).
  triggerEvent   Json             @map("trigger_event")
  plan           Json
  status         TriggerRunStatus @default(RUNNING)
  stopReason     String?          @map("stop_reason")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(3)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions AutomationExecution[]

  @@unique([tenantId, eventId])
  @@map("automation_trigger_runs")
}

model AutomationExecution {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  flowId         String          @map("flow_id") @db.Uuid
  flowVersionId  String          @map("flow_version_id") @db.Uuid
  triggerRunId   String?         @map("trigger_run_id") @db.Uuid
  contactId      String          @map("contact_id") @db.Uuid
  conversationId String?         @map("conversation_id") @db.Uuid
  triggerEvent   Json            @map("trigger_event")
  status         ExecutionStatus @default(RUNNING)
  currentNodeId  String?         @map("current_node_id")
  waitUntil      DateTime?       @map("wait_until") @db.Timestamptz(3)
  /// Variables saved by steps (webhook responses): `vars`.
  context        Json            @default("{}")
  stepCount      Int             @default(0) @map("step_count")
  errorCode      String?         @map("error_code")
  errorDetail    String?         @map("error_detail")
  startedAt      DateTime        @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?       @map("finished_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  flow        Flow                      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersion FlowVersion               @relation(fields: [flowVersionId], references: [id], onDelete: Cascade)
  triggerRun  AutomationTriggerRun?     @relation(fields: [triggerRunId], references: [id], onDelete: SetNull)
  steps       AutomationExecutionStep[]

  /// One execution per flow per triggering event (redelivered events and retries can't add one).
  @@unique([triggerRunId, flowId])
  @@index([tenantId, flowId, startedAt(sort: Desc)])
  @@index([tenantId, conversationId, status])
  @@index([tenantId, startedAt])
  @@map("automation_executions")
}

/// Append-only step history (UPDATE/DELETE revoked). One row per executed node.
model AutomationExecutionStep {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  executionId String     @map("execution_id") @db.Uuid
  seq         Int
  nodeId      String     @map("node_id")
  nodeType    String     @map("node_type")
  status      StepStatus
  input       Json       @default("{}")
  output      Json       @default("{}")
  errorCode   String?    @map("error_code")
  errorDetail String?    @map("error_detail")
  startedAt   DateTime   @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?  @map("finished_at") @db.Timestamptz(3)

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  execution AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, seq])
  @@index([tenantId, startedAt])
  @@map("automation_execution_steps")
}

// ---------------------------------------------------------------------------------------------
// Analytics (Phase 11 Step 2, docs/ANALYTICS.md). Derived projections only: operational tables,
// the ledger and usage_events stay authoritative, and every projection can be rebuilt.
// ---------------------------------------------------------------------------------------------

/// Append-only log of the domain events analytics consumed; unique per source event, so a
/// redelivered event is recorded (and counted) once. Purged by analytics retention (P11-D15).
model AnalyticsEvent {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// The outbox event id (the deduplication identity).
  sourceEventId String   @map("source_event_id") @db.Uuid
  eventType     String   @map("event_type")
  /// When it happened (for conversation.opened: the customer's message time).
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  /// The message, conversation, campaign or execution the event is about.
  subjectId     String?  @map("subject_id") @db.Uuid
  dims          Json     @default("{}")
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceEventId])
  @@index([tenantId, eventType, occurredAt])
  @@map("analytics_events")
}

/// Daily aggregates per workspace-local day. Recomputed (never incremented) from source data.
model AnalyticsDailyRollup {
  tenantId  String   @map("tenant_id") @db.Uuid
  day       DateTime @db.Date
  metric    String
  /// "" for the total, or "dimension:value" (for example "category:UTILITY").
  dimsKey   String   @default("") @map("dims_key")
  value     BigInt
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day, metric, dimsKey])
  @@index([tenantId, metric, day])
  @@map("analytics_daily_rollups")
}

/// One customer-opened conversation episode (a conversation.opened event), with its first human
/// reply and resolution derived from message history (docs/ANALYTICS.md → Inbox).
model AnalyticsConversationEpisode {
  /// The conversation.opened source event id.
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  conversationId   String    @map("conversation_id") @db.Uuid
  openedAt         DateTime  @map("opened_at") @db.Timestamptz(3)
  day              DateTime  @db.Date
  firstResponseAt  DateTime? @map("first_response_at") @db.Timestamptz(3)
  firstResponderId String?   @map("first_responder_id") @db.Uuid
  resolvedAt       DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolvedBy       String?   @map("resolved_by") @db.Uuid
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, day])
  @@index([tenantId, conversationId, openedAt])
  @@map("analytics_conversation_episodes")
}

/// Work queue for the rollup pass: a day (scope "day", key YYYY-MM-DD) or a campaign (scope
/// "campaign", key id) whose aggregates must be recomputed. Durable, so Redis loss loses nothing.
model AnalyticsDirty {
  tenantId String   @map("tenant_id") @db.Uuid
  scope    String
  key      String
  markedAt DateTime @default(now()) @map("marked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, scope, key])
  @@map("analytics_dirty")
}

/// Projection health per workspace: freshness, failures, and the timezone/retention the
/// rollups were built with (a change triggers a rebuild).
model AnalyticsTenantState {
  tenantId      String    @id @map("tenant_id") @db.Uuid
  timezone      String?
  retentionDays Int?      @map("retention_days")
  backfilledAt  DateTime? @map("backfilled_at") @db.Timestamptz(3)
  lastEventAt   DateTime? @map("last_event_at") @db.Timestamptz(3)
  lastRollupAt  DateTime? @map("last_rollup_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  lastErrorAt   DateTime? @map("last_error_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("analytics_tenant_state")
}

// ---------------------------------------------------------------------------------------------
// API keys and outbound webhooks (Phase 11 Step 3, docs/API_KEYS.md, docs/WEBHOOKS.md).
// ---------------------------------------------------------------------------------------------

/// A tenant-scoped API key (decision P11-D18). Only `keyHash` (sha256 of the secret + a server
/// pepper) is stored; the secret itself is shown once, at creation, and never again.
model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  /// 8 chars, unique platform-wide: looked up via X7 before the tenant is known.
  prefix     String    @unique @db.Char(8)
  keyHash    Bytes     @map("key_hash")
  /// Permission keys from API_KEY_SCOPES only; a subset of the creator's own permissions at
  /// creation time (P11-D18, P11-D22). Never a source of authority beyond RBAC.
  scopes     String[]
  createdBy  String?   @map("created_by") @db.Uuid
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator User?  @relation("ApiKeyCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tenantId, revokedAt])
  @@map("api_keys")
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED

  @@map("webhook_endpoint_status")
}

/// A customer-configured outbound webhook destination (docs/WEBHOOKS.md). `secretCiphertext` is
/// AES-256-GCM (the shared keyRing); the plaintext secret is shown once, at creation/rotation.
model WebhookEndpoint {
  id               String                @id @default(uuid(7)) @db.Uuid
  tenantId         String                @map("tenant_id") @db.Uuid
  name             String
  url              String
  secretCiphertext Bytes                 @map("secret_ciphertext")
  /// Event types from WEBHOOK_EVENTS only (an explicit allowlist, never every internal event).
  events           String[]
  status           WebhookEndpointStatus @default(ACTIVE)
  /// Consecutive delivery failures since the last success; disables the endpoint past a threshold.
  failureCount     Int                   @default(0) @map("failure_count")
  createdBy        String?               @map("created_by") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator    User?             @relation("WebhookEndpointCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("webhook_delivery_status")
}

/// One delivery attempt history entry (retention 30 days, docs/WEBHOOKS.md). `eventId` is the
/// source domain event id: redelivery of the same event reuses the same row set (idempotent).
model WebhookDelivery {
  id             String                @id @default(uuid(7)) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  endpointId     String                @map("endpoint_id") @db.Uuid
  eventId        String                @map("event_id") @db.Uuid
  eventType      String                @map("event_type")
  /// The exact payload sent (the versioned external contract), for redelivery and audit.
  payload        Json
  attempt        Int                   @default(1)
  status         WebhookDeliveryStatus @default(PENDING)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  durationMs     Int?                  @map("duration_ms")
  errorCode      String?               @map("error_code")
  nextAttemptAt  DateTime?             @map("next_attempt_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([tenantId, endpointId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

/// Global authorization; writable only with migration credentials by restricted CLI.
model PlatformGrant {
  userId String @id @map("user_id") @db.Uuid
  role String @default("PLATFORM_OPERATOR")
  version Int @default(1)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  reason String
  grantedBy String @map("granted_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@map("platform_grants")
}

/// Immutable platform security/access trail. No customer content or credentials.
model PlatformAudit {
  id String @id @default(uuid(7)) @db.Uuid
  operatorId String? @map("operator_id") @db.Uuid
  workspaceId String? @map("workspace_id") @db.Uuid
  action String
  outcome String
  correlationId String? @map("correlation_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([createdAt(sort: Desc), id])
  @@map("platform_audit")
}

model PlatformChallenge {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash Bytes @unique @map("token_hash")
  grantVersion Int @map("grant_version")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  @@map("platform_challenges")
}
model PlatformSession {
  id String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid
  parentFamilyId String @map("parent_family_id") @db.Uuid
  tokenHash Bytes @unique @map("token_hash")
  csrfHash Bytes @map("csrf_hash")
  grantVersion Int @map("grant_version")
  mfaAt DateTime @map("mfa_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  @@index([userId])
  @@map("platform_sessions")
}

/// Tenant-owned immutable commercial receipt, created atomically with domain mutations.
model CommercialOperation {
  id String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  operatorId String @map("operator_id") @db.Uuid
  operation String
  amountMinor BigInt? @map("amount_minor")
  currency String? @db.Char(3)
  reason String
  reference String
  idempotencyKey String @map("idempotency_key")
  requestHash String @map("request_hash")
  before Json
  after Json
  result Json
  correlationId String? @map("correlation_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt(sort: Desc), id])
  @@map("commercial_operations")
}
