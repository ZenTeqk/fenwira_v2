enum FilePurpose {
  MESSAGE_MEDIA
  IMPORT
  EXPORT
  AVATAR
  TEMPLATE_SAMPLE

  @@map("file_purpose")
}

enum FileStatus {
  PENDING_UPLOAD
  READY
  REJECTED

  @@map("file_status")
}

/// Objects in MinIO/S3. Browsers upload with presigned URLs; READY after the server checks it.
model File {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  bucket     String
  objectKey  String      @map("object_key")
  mimeType   String      @map("mime_type")
  sizeBytes  BigInt      @map("size_bytes")
  filename   String?
  sha256     Bytes?
  purpose    FilePurpose
  status     FileStatus  @default(PENDING_UPLOAD)
  uploadedBy String?     @map("uploaded_by") @db.Uuid
