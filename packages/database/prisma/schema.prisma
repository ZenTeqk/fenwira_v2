/// P11-D12 wallet funds states (NOT_ENFORCED is computed, never stored).
enum WalletFundsState {
  NORMAL
  LOW_BALANCE
  INSUFFICIENT_FUNDS

  @@map("wallet_funds_state")
}

enum ReservationStatus {
  ACTIVE
  SETTLED
  RELEASED

  @@map("reservation_status")
