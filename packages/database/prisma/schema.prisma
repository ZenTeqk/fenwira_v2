  settledTransactionId String?           @map("settled_transaction_id") @db.Uuid
  reason               String?
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet             Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  settledTransaction WalletTransaction? @relation(fields: [settledTransactionId], references: [id], onDelete: SetNull)

  @@index([walletId, status])
  @@map("wallet_reservations")
}

/// Append-only record of each billable message Meta priced.
model UsageEvent {
